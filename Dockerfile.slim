\
    # Slim image: multi-stage, no apt in runtime stage
    # Builder: install Python deps into a venv
    FROM python:3.11-slim AS builder
    WORKDIR /build

    ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
        PYTHONDONTWRITEBYTECODE=1 \
        PYTHONUNBUFFERED=1

    RUN python -m venv /opt/venv
    ENV PATH="/opt/venv/bin:$PATH"

    # Install deps without cache
    RUN pip install --no-cache-dir --upgrade pip \
        && pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu \
        && pip install --no-cache-dir pillow

    # Runtime: only what we need (no apt here)
    FROM python:3.11-slim AS runtime
    WORKDIR /app

    ENV PATH="/opt/venv/bin:$PATH" \
        PYTHONDONTWRITEBYTECODE=1 \
        PYTHONUNBUFFERED=1

    COPY --from=builder /opt/venv /opt/venv
    COPY inference.py /app/inference.py
    COPY model.pt /app/model.pt

    # Non-root user (optional, but nice)
    RUN useradd -m appuser
    USER appuser

    CMD ["python", "/app/inference.py", "/data/image.jpg", "--model-path", "/app/model.pt", "--topk", "3"]
