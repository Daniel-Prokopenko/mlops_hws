\
    # Fat image: intentionally large & fully equipped
    FROM ubuntu:22.04

    ENV DEBIAN_FRONTEND=noninteractive
    WORKDIR /app

    # Lots of tools (intentionally), plus Python and pip
    RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv \
        build-essential git curl wget vim \
        && rm -rf /var/lib/apt/lists/*

    # Big Python deps (torch/torchvision are heavy)
    RUN python3 -m pip install --upgrade pip \
        && python3 -m pip install torch torchvision --index-url https://download.pytorch.org/whl/cpu \
        && python3 -m pip install pillow

    COPY inference.py /app/inference.py
    COPY model.pt /app/model.pt

    # Default command expects you to mount an image into /data/image.jpg
    # Example:
    #   docker run --rm -v "$PWD/sample.jpg:/data/image.jpg:ro" ml-fat
    CMD ["python3", "/app/inference.py", "/data/image.jpg", "--model-path", "/app/model.pt", "--topk", "3"]
